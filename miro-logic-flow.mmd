flowchart TD
    classDef user fill:#E3F2FD,stroke:#1976D2,stroke-width:2px,color:#0D47A1
    classDef api fill:#FFF3E0,stroke:#F57C00,stroke-width:2px,color:#E65100
    classDef google fill:#E8F5E9,stroke:#388E3C,stroke-width:2px,color:#1B5E20
    classDef openai fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C
    classDef dfs fill:#FBE9E7,stroke:#D84315,stroke-width:2px,color:#BF360C
    classDef data fill:#FFFDE7,stroke:#F9A825,stroke-width:2px,color:#F57F17
    classDef error fill:#FFEBEE,stroke:#C62828,stroke-width:2px,color:#B71C1C
    classDef result fill:#E0F7FA,stroke:#00838F,stroke-width:2px,color:#006064

    U1([U1 — User lands on homepage]):::user
    U1 --> U2[U2 — Types business name\ne.g. 'SwiftHand Painting']:::user
    U2 --> U3[U3 — Autocomplete fires\nGET /api/places-autocomplete]:::google
    U3 --> U4[U4 — User selects suggestion\nAuto-fills city + website]:::user
    U4 --> U5[U5 — Clicks 'See Who's Outranking You']:::user
    U5 --> U6[U6 — Passes businessName, city, website\nto Step 2]:::user

    U6 --> S1([S1 — Step 2 loads]):::user
    S1 --> S2[S2 — Progress bar 0→90%\ncaps until API returns]:::user
    S1 --> S3[S3 — 7 discovery items reveal\non timed intervals]:::user
    S1 --> A1

    A1[A1 — POST /api/gbp-audit\nbusinessName, city, industry]:::api
    A1 --> A2{A2 — Rate limit check\n3 req/hour/IP}:::api
    A2 -->|Blocked| E1[E1 — Return 429\nUser sees error screen]:::error
    A2 -->|OK| G1

    G1[G1 — Google Places Text Search\n'SwiftHand Painting Sandy, UT']:::google
    G1 -->|Not found| E2[E2 — Error: No listing found]:::error
    G1 -->|Found| G2[G2 — Get place_id]:::google
    G2 --> G3[G3 — Google Places Details\nrating, reviews, photos, address\nphone, website, categories, photo_reference]:::google
    G3 --> G4[G4 — Build profile snapshot\n+ extract photoUrl]:::data

    G4 --> P1([P1 — Run in PARALLEL]):::api

    P1 --> O1[O1 — GPT-4o-mini analyzes profile]:::openai
    O1 --> O2[O2 — Scoring rules applied\nreviews, website, phone\nphotos, description, rating]:::openai
    O2 --> O3[O3 — Returns: score, competitorScore\naiSummary, missedOpportunities\nkeywordGaps, recommendations\nsuggestedPosts, suggestedQA]:::data

    P1 --> K1[K1 — Build 5 seed keywords\nfrom category + city templates]:::dfs
    K1 --> K2[K2 — DataForSEO keywords_for_keywords\nReal Google Ads keyword ideas\nlocation = state level, limit 50]:::dfs
    K2 --> K3{K3 — Business has website?}:::dfs
    K3 -->|Yes| K4[K4 — DataForSEO keywords_for_site\nPull keywords Google associates\nwith the website, limit 30]:::dfs
    K3 -->|No| K5[K5 — Skip, use seeds only]:::dfs
    K4 --> K6[K6 — Merge + deduplicate\nall real keywords]:::data
    K5 --> K6

    K6 --> V1[V1 — DataForSEO Search Volume\nTry city-level location]:::dfs
    V1 --> V2{V2 — City hits > 33%?}:::dfs
    V2 -->|Yes| V5
    V2 -->|No| V3[V3 — Fallback: state-level]:::dfs
    V3 --> V4{V4 — State hits > 33%?}:::dfs
    V4 -->|Yes| V5
    V4 -->|No| V6[V6 — Fallback: national\nor estimate volumes]:::dfs
    V6 --> V5[V5 — Take top 10 keywords\nby volume]:::data

    V5 --> R1[R1 — DataForSEO SERP check\nAll 10 keywords IN PARALLEL\ndepth 20 organic results]:::dfs
    R1 --> R2[R2 — For each keyword:\nfind your rank + collect\nall competitor domains]:::dfs
    R2 --> R3[R3 — Score all domains\nacross all 10 SERPs\nexclude directories]:::dfs
    R3 --> R4[R4 — Primary competitor =\nhighest scoring domain]:::data
    R4 --> R5[R5 — Build gap keywords\nonly where competitor\noutranks you or you\ndon't rank at all]:::dfs
    R5 --> R6[R6 — Calculate traffic opportunity\nper keyword using CTR curve\nPos1=28% Pos2=15% Pos3=11%]:::dfs
    R6 --> R7[R7 — Market scan result:\ngapKeywords, primaryCompetitor\ntopCompetitors, missedTraffic]:::data

    O3 & R7 --> C1([C1 — Find competitor profile]):::api

    C1 --> C2[C2 — Attempt A: Search Google Places\nfor SERP-detected competitor\ntry 3 name variations]:::google
    C2 -->|Found| C5
    C2 -->|Not found| C3[C3 — Attempt B: Search\n'best painter in city'\n'top rated painter city'\n'painter city']:::google
    C3 -->|Found| C5
    C3 -->|Not found| C4[C4 — Attempt C: Last resort\nmarket-average competitor\nslightly better stats than you]:::data
    C4 --> C5[C5 — Competitor profile ready\nname, rating, reviews, photos\nwebsite, phone, photoUrl]:::data

    C5 --> F1[F1 — Assemble full AuditResult]:::api
    F1 --> F2[F2 — marketScan object\nkeywords, competitors\nmissedTraffic, profiles + photos]:::data
    F1 --> F3[F3 — comparison object\nscore, aiSummary, gaps]:::data
    F1 --> F4[F4 — recommendations\nposts, Q&A]:::data

    F2 & F3 & F4 --> F5[F5 — Return JSON to frontend]:::api

    F5 --> T1[T1 — Progress bar → 100%\n500ms delay, auto-advance]:::user

    T1 --> D1([D1 — Step 3 Results Page]):::result
    D1 --> D2[D2 — Shock headline\n'Invisible for X of Y keywords']:::result
    D2 --> D3[D3 — Missed calls card\nmissedTraffic × 4.2% call rate]:::result
    D3 --> D4[D4 — Visibility score gauge\ncircular 0-100, color coded]:::result
    D4 --> D5[D5 — Head-to-head comparison\nLogos + Rating + Reviews\nPhotos + Website + Phone\ngreen=winning red=losing]:::result
    D5 --> D6[D6 — Top keyword opportunity\nbiggest traffic gap keyword]:::result
    D6 --> D7[D7 — AI assessment paragraph]:::result
    D7 --> D8[D8 — CTA: Show Me How to Fix This]:::result
    D8 --> D9([D9 — Step 4: DIY $9.99 or Free AI]):::user
